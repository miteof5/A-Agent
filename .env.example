# ===== ActionAgent 环境变量模板 =====
# 使用方法：把本文件复制为 .env（.env 已被 .gitignore 排除，绝不会提交 git），填写真实值。
# 所有 AA_ 前缀变量均可被系统环境变量覆盖（.env 优先级最低）。
# 注意：占位符一律用英文 REPLACE_ME 标记。若直接复制示例"sk-xxx"占位符使用，
# 非 ASCII 字符会拼进 Authorization 头触发编码错误，服务会在调用时报错。

# ---- 主模型（必填，与现有配置一致）----
# 留空则回退系统环境变量 DASHSCOPE_API_KEY（或系统级 AA_LLM_API_KEY）
AA_LLM_API_KEY=
AA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AA_LLM_MODEL=deepseek-v4-flash-0731

# ---- 联网搜索（S5.4 必填：Tavily API Key，https://tavily.com 注册，免费额度 1000 次/月）----
AA_SEARCH_API_KEY=tvly-REPLACE_ME
AA_SEARCH_BASE_URL=https://api.tavily.com

# ---- 压缩小模型（S5.4 可选：记忆压缩/网页正文压缩用）----
# 三行留空 → 自动回退主模型三件套；想换更便宜的小模型填真实值即可（只改 AA_SUMM_MODEL 也行）
AA_SUMM_MODEL=
AA_SUMM_BASE_URL=
AA_SUMM_API_KEY=
