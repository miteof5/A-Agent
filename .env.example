# ===== ActionAgent 环境变量模板 =====
# 使用方法：把本文件复制为 .env（.env 已被 .gitignore 排除，绝不会提交 git），填写真实值。
# 所有 AA_ 前缀变量均可被系统环境变量覆盖（.env 优先级最低）。

# ---- 主模型（必填，与现有配置一致）----
AA_LLM_API_KEY=sk-你的主模型key
AA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AA_LLM_MODEL=deepseek-v4-flash-0731

# ---- 联网搜索（S5.4 必填：Tavily API Key，https://tavily.com 注册，免费额度 1000 次/月）----
AA_SEARCH_API_KEY=tvly-你的tavily_key
AA_SEARCH_BASE_URL=https://api.tavily.com

# ---- 压缩小模型（S5.4 可选：记忆压缩/网页正文压缩用）----
# 不填则自动复用上面主模型三件套（key/base_url/model）；想换更便宜的小模型只改这里：
AA_SUMM_MODEL=qwen3.8-flash
AA_SUMM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AA_SUMM_API_KEY=sk-你的小模型key
