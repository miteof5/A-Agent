{
  "_comment": [
    "能力表（思考与答案分离 Spec §5.5）。key 的维度是「网关 + 模型」，不是厂商：",
    "决定字段名/参数形状/回传规则的是 base_url 后面那层兼容实现。",
    "继承顺序：probes > models > groups > gateways > 保守默认（capabilities.py 的 DEFAULTS）。",
    "改这里之前先跑 python tests/test_capabilities.py —— 继承顺序写反会让模型『切换时正常、任务里 400』。"
  ],
  "gateways": {
    "dashscope": {
      "match": "dashscope.aliyuncs.com",
      "reasoning_fields": ["reasoning_content", "reasoning"],
      "thinking_param": { "enable_thinking": true },
      "echo_reasoning_with_tools": true,
      "must_echo_cross_turn": false,
      "supports_temperature": true,
      "supports_tools": true
    }
  },
  "groups": {
    "阿里云·通义千问": { "supports_tools": true, "supports_temperature": true },
    "DeepSeek": { "supports_temperature": true, "must_echo_cross_turn": "when_thinking" },
    "Kimi": { "supports_temperature": false, "thinking_param": null },
    "智谱 GLM": { "supports_temperature": true, "thinking_param": null },
    "多模态（阿里云·通义千问）": { "supports_temperature": false, "thinking_param": null }
  },
  "models": {
    "kimi-k3": { "supports_temperature": false },
    "qwen3.8-omni-flash": { "supports_temperature": false },
    "qwen3.8-omni-flash-realtime": {
      "supported": false,
      "reason": "实时语音模型，不走 chat.completions + tools；留在清单里可见但不可选，比静默消失好诊断"
    }
  }
}
